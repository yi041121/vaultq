# PostgreSQL connection string (use the pooled Neon/Supabase URL on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Locker hardware
HARDWARE_API_KEY="replace-with-a-device-key"
HARDWARE_SESSION_SECRET="replace-with-a-second-random-secret"
LOCKER_NUMBER="B03"
