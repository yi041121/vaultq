# PostgreSQL connection string (use the pooled Neon/Supabase URL on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth
# At least 32 characters, unique per environment. There is no fallback:
# a missing or weak value makes sign-in fail closed.
JWT_SECRET="replace-with-a-long-random-string-at-least-32-characters"
# Optional. If set, must be at least 32 characters. Otherwise a separate
# image-signing key is derived from JWT_SECRET.
IMAGE_SIGNING_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate limiting
# Vercel sets VERCEL=1 automatically. For another trusted reverse proxy that
# overwrites X-Forwarded-For, set this to "true". Leave unset otherwise so
# client-supplied forwarding headers are ignored.
AUTH_TRUST_PROXY=""

# Locker hardware
# Server-owned device registry. Generate a DIFFERENT random key (32+ characters)
# for each device. Existing single-key configuration is no longer accepted.
# Set this JSON in deployment secrets, never in NEXT_PUBLIC_* or firmware repos.
HARDWARE_DEVICES='[{"deviceId":"locker-01","lockerNumber":"B03","apiKey":"replace-with-a-unique-random-device-key-32-chars"}]'
HARDWARE_SESSION_SECRET="replace-with-a-second-random-secret-at-least-32-characters"
